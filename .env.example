# Cấu hình cho tính năng shadowing — copy file này thành .env.local rồi điền giá trị.
# .env.local đã nằm trong .gitignore nên không bị commit.
#
# PHASE 1 (video + phụ đề + ghi âm + nghe lại) KHÔNG CẦN gì ở đây — bỏ trống vẫn chạy.
# Chỉ phần Speech-to-Text mới cần.

# --- Firebase (lấy ở Console -> Project settings -> Your apps -> SDK setup) ---
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=my-page-39b31.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=my-page-39b31
REACT_APP_FIREBASE_STORAGE_BUCKET=my-page-39b31.appspot.com
REACT_APP_FIREBASE_APP_ID=

# Phải trùng region đã deploy Cloud Function
REACT_APP_FUNCTIONS_REGION=asia-southeast1

# Đặt thành "firestore" để đọc bài học từ Firestore thay vì src/data/shadowing.js
REACT_APP_SHADOWING_SOURCE=static
