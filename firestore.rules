rules_version = '2';

// Trang cá nhân, chỉ một chủ sở hữu.
// ⚠️ THAY 'REPLACE_WITH_YOUR_UID' bằng uid thật trước khi deploy:
//    Firebase Console -> Authentication -> Users -> cột User UID

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return request.auth != null
          && request.auth.uid == 'REPLACE_WITH_YOUR_UID';
    }

    // Bài học: client tự soạn và tự lưu, nên được ghi bài của chính mình.
    // Khác với shadowing_attempts bên dưới — ở đó điểm số do server tính nên
    // client không được ghi, nếu không dữ liệu luyện tập mất hết ý nghĩa.
    match /shadowing_videos/{videoId} {
      allow read: if isOwner();
      allow create, update: if isOwner()
                            && request.resource.data.ownerUid == request.auth.uid
                            && videoId.matches("^[A-Za-z0-9_-]{11}$");
      allow delete: if isOwner() && resource.data.ownerUid == request.auth.uid;
    }

    // Lịch sử luyện tập: CHỈ Cloud Function (Admin SDK, bỏ qua rules) được ghi.
    // Nếu cho client ghi thì score/confidence do client tự khai -> dữ liệu vô nghĩa.
    match /shadowing_attempts/{attemptId} {
      allow read:   if isOwner() && resource.data.ownerUid == request.auth.uid;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // Mặc định từ chối mọi thứ khác
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
